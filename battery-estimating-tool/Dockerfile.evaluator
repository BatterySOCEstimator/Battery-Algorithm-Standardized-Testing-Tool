# Python evaluator sandbox
# NOT a long-lived service. the backend spawns a container per evaluation
# and removes it when done.

FROM python:3.12-slim

WORKDIR /evaluator

# Install Python dependencies
RUN pip install --no-cache-dir \
    numpy==2.4.4 \
    pandas==3.0.1 \
    scipy==1.17.1 \
    matplotlib==3.10.8 \
    dask==2026.3.0 \
    coiled==1.133.1 \
    pyarrow==23.0.1 

# Login to coiled 
#ARG COILED_TOKEN -- FOR PROD
#RUN coiled login --token "$COILED_TOKEN" -- FOR PROD 
RUN coiled login --token 2563f40370ea42afa81fffdea84e1d60-df83f824d85e6989a54162111c49df7f3351a488

# Copy the evaluation tool source and data files
COPY backend/src/evaluator/SETool_Python/ /evaluator/

# Remove the venv from the image (deps installed system-wide above)
RUN rm -rf /evaluator/venv /evaluator/__pycache__

# Container expects:
#   - /uploads/<modelDir> mounted in, containing the .zip
#   - stdout: JSON result
#   - stderr: diagnostic logs
ENTRYPOINT ["python", "standardized_evaluation_tool.py"]
